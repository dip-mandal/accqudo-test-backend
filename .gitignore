**/service-account.json
**/*firebase-adminsdk*.json

*.key
*.p12




# Production/local test environment files
backend/.env.cloudrun-test
backend/.env.production
backend/.env.local
apps/web/.env.local
apps/web/.env.production
apps/web/.env.production.local

alembic/*

alembic/
# ------------------------------------------------------------
# Firebase / Service Account Credentials
# ------------------------------------------------------------
**/service-account.json
**/firebase-service-account.json
**/*firebase-adminsdk*.json
**/firebase-adminsdk-*.json

# Never commit private keys
**/*.pem
**/*.key
**/*.p12
**/*.crt

# IMPORTANT:
# The Aiven CA certificate is required inside the production image.
# Therefore, if your CA file is named ca.pem, explicitly allow it:
!backend/certs/
!backend/certs/ca.pem

